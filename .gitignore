# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Secrets (the current key file is named ".env " with a trailing space)
.env*

# Experiment outputs: checkpoints, reports and logs stay out of source control
artifacts/
outputs/
reports/
wandb/
*.log
/data/cf_benchmarks/

# Model weights and checkpoints, wherever they end up
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
models/
checkpoint-*/

# Hugging Face & dataset cache
cache-*.arrow
.cache/

# Shell scripts are ignored unless listed here
*.sh
!run_fp32_master_rerun.sh
!scripts/*.sh
